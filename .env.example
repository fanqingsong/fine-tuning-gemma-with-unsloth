# Hugging Face token for gated models and uploads
HF_TOKEN=

# Optional China mirror, e.g. https://hf-mirror.com
HF_ENDPOINT=

# Default model used by train/infer when --model-name is omitted
MODEL_NAME=unsloth/gemma-3-270m-it

# Optional: only needed for src/generate_data.py (Gemini Batch API)
GOOGLE_API_KEY=
